# Edge Alert — Environment Configuration
# Copy this to .env and fill in your values

# ── Telegram ─────────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Signal delivery channels (use @userinfobot or getUpdates API to find chat IDs)
TELEGRAM_SIGNALS_CHAT_ID=your_signals_channel_id_here
TELEGRAM_OPS_CHAT_ID=your_ops_channel_id_here
TELEGRAM_CEO_CHAT_ID=your_ceo_dm_id_here

# Preview channel for delayed signals (free tier marketing funnel)
TELEGRAM_PREVIEW_CHANNEL_ID=your_preview_channel_id_here

# Customer-facing signals channel (for invite link generation)
TELEGRAM_SIGNALS_CHANNEL_ID=your_signals_channel_id_here

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_PRICE_BASIC=price_basic_id_here
STRIPE_PRICE_PRO=price_pro_id_here

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=alerts@northstaraitools.com

# ── Application ──────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5050
FLASK_SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///edge_alert.db
